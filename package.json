{
  "name": "miswitch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local provider switcher for Claude Code, Codex CLI and Pi Coding Agent",
  "main": "dist-desktop/main.cjs",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "tsc --noEmit && vite build && node scripts/build-desktop.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:desktop": "npm run build && electron scripts/smoke-desktop.cjs",
    "package": "npm run build && electron-builder",
    "test:container": "docker build -t miswitch-cli-test -f tests/container/Dockerfile . && docker run --rm miswitch-cli-test"
  },
  "dependencies": {
    "@iarna/toml": "2.2.5",
    "proper-lockfile": "4.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "44.7.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "8.3.4"
  },
  "build": {
    "appId": "dev.miswitch.app",
    "productName": "Mi-Switch",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-desktop/**",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
